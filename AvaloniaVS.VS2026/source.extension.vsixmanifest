<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
        <!-- VS2026 专用扩展 Identity，可与 VS2022 包并存 -->
        <Identity Id="AxamlTPreviewer.VS2026" Version="21.10.1" Language="en-US" Publisher="kongdetuo" />
        <DisplayName>AxamlTPreviewer for Visual Studio 2026</DisplayName>
        <Description xml:space="preserve">面向 Visual Studio 2026 的 Avalonia/AXAML 增强扩展（基于开源 AvaloniaVS 的 MIT 衍生版，非官方产品）。提供实时预览、智能补全、样式类补全、转到定义、已废弃成员提示，以及 Avalonia 12.1 项目/项模板（Window、UserControl、资源字典、Styles 等）。</Description>
    <Icon>icon.ico</Icon>
  </Metadata>
  <Installation>
    <!-- Visual Studio 2026 产品版本为 18.x；无上界以便后续小版本兼容 -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.0,)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" DisplayName="Visual Studio core editor" Version="[15.0,)" />
    <Prerequisite Id="Microsoft.NetCore.Component.DevelopmentTools" DisplayName=".NET Core development tools" Version="[15.8.27729.1,)" />
    <Prerequisite Id="Microsoft.VisualStudio.Component.Roslyn.LanguageServices" DisplayName="C# and Visual Basic" Version="[15.0.26208.0,)" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" d:Source="Project" d:ProjectName="%CurrentProject%" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="|%CurrentProject%|" d:Source="Project" d:ProjectName="%CurrentProject%" />
    <!-- 注册 CLI/TemplateEngine 项目模板包 -->
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="Templates.pkgdef" d:Source="File" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="icons.pkgdef" d:Source="File" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="Snippets\snippets.pkgdef" d:Source="File" />
    <!-- 「添加新项」Avalonia 项模板 -->
    <Asset Type="Microsoft.VisualStudio.ItemTemplate" d:Source="Project" d:ProjectName="AvaloniaWindowTemplate" d:TargetPath="|AvaloniaWindowTemplate;TemplateProjectOutputGroup|" Path="ItemTemplates" d:VsixSubPath="ItemTemplates" />
    <Asset Type="Microsoft.VisualStudio.ItemTemplate" d:Source="Project" d:ProjectName="AvaloniaUserControlTemplate" d:TargetPath="|AvaloniaUserControlTemplate;TemplateProjectOutputGroup|" Path="ItemTemplates" d:VsixSubPath="ItemTemplates" />
    <Asset Type="Microsoft.VisualStudio.ItemTemplate" d:Source="Project" d:ProjectName="AvaloniaTemplatedControlTemplate" d:TargetPath="|AvaloniaTemplatedControlTemplate;TemplateProjectOutputGroup|" Path="ItemTemplates" d:VsixSubPath="ItemTemplates" />
    <Asset Type="Microsoft.VisualStudio.ItemTemplate" d:Source="Project" d:ProjectName="AvaloniaResourceDictionaryTemplate" d:TargetPath="|AvaloniaResourceDictionaryTemplate;TemplateProjectOutputGroup|" Path="ItemTemplates" d:VsixSubPath="ItemTemplates" />
    <Asset Type="Microsoft.VisualStudio.ItemTemplate" d:Source="Project" d:ProjectName="AvaloniaStylesTemplate" d:TargetPath="|AvaloniaStylesTemplate;TemplateProjectOutputGroup|" Path="ItemTemplates" d:VsixSubPath="ItemTemplates" />
  </Assets>
</PackageManifest>
